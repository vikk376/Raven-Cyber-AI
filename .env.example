# Copy to .env and fill in. Never commit .env.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
REDIRECT_URI=http://localhost:8501

MCP_SERVER_URL=https://sentinel.microsoft.com/mcp/data-exploration
MCP_SCOPE=4500ebfb-89b6-4b14-a480-7f749797bfcd/.default
ARM_SCOPE=https://management.azure.com/user_impersonation

AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Optional embeddings deployment for semantic search in the Data Lake (blank = keyword search only)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

EMAIL_TO=
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# One variable per Logic App with an HTTP request trigger (add more in Admin > Containment)
LOGICAPP_INCIDENT_URL=

BOOTSTRAP_ADMIN_EMAIL=
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=
SENTINEL_WORKSPACE_ID=

DB_PATH=data/sentinel_platform.db
LOG_LEVEL=INFO

# ---------- Raven Cyber AI: containment targets ----------
# Encrypts stored Logic App URLs and API headers. Keep it stable; if it changes, re-enter the target URLs.
# If empty, a random key file is created at data/secret.key instead.
APP_SECRET_KEY=
# API keys for API targets: any variable starting with CONTAINMENT_ can be used as {{env.CONTAINMENT_NAME}} in headers and body
# CONTAINMENT_FIREWALL_KEY=
# Lab only: allow private network and plain http targets (also settable in Admin > Containment)
# ALLOW_PRIVATE_TARGETS=true
